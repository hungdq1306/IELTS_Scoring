# Copy the required values into your ROOT .env (keep existing GEMINI_API_KEY).
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Direct Neon endpoint for Alembic (never expose either URL in frontend):
MIGRATION_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
FRONTEND_ORIGIN=http://localhost:5173
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Optional PUBLIC PEM. JWKS is fetched from CLERK_ISSUER by default.
CLERK_JWT_KEY=
CLERK_AUDIENCE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PRACTICE_ANSWER_MODEL=gemini-3.1-flash-lite
# Set these from YOUR project's actual AI Studio model quotas.
GEMINI_MAX_RPM=5
GEMINI_MAX_TPM=100000
GEMINI_MAX_RPD=200
GEMINI_MAX_CONCURRENT=2
GEMINI_DATA_POLICY=unconfirmed
GEMINI_TIMEOUT_SECONDS=45
DAILY_SUBMISSION_LIMIT=5
DAILY_PRACTICE_LIMIT=30
ENABLE_PRACTICE_GEN=true
PRACTICE_ITEMS_PER_SET=4
WORKER_ENABLED=true
WORKER_COUNT=2
WORKER_LEASE_SECONDS=120
JOB_TIMEOUT_SECONDS=600
JOB_MAX_ATTEMPTS=3
RETENTION_DAYS=30
