GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PRACTICE_ANSWER_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_CONCURRENT_REQUESTS=1
GEMINI_REQUESTS_PER_MINUTE=5
GEMINI_DAILY_REQUEST_BUDGET=20
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2

# Web assessment retries; CLI benchmarks retain GEMINI_MAX_RETRIES.
GEMINI_WEB_MAX_RETRIES=4

FEWSHOT_REFERENCE_SOURCE=writing9
FEWSHOT_CONFIG_VERSION=fs-fixed-v1

# Independent lecturer snapshot. Keep diagnostic mode disabled in production.
FEWSHOT_ALLOW_UNVERIFIED_PROMPTS=false
# FEWSHOT_LECTURER_MANIFEST=data/lecturer/manifests/fs5_v1.json

# Primary LLM provider (active: gemini; switch to anthropic when ready)
LLM_PROVIDER=gemini

# Future Paid Provider (Claude Haiku 5.5 — fill ANTHROPIC_API_KEY when switching)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_PROMPT_CACHE=true
